{
  "$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
  "root": true,
  "files": {
    "includes": [
      "**",
      "!src/generated.ts"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "rules": {
      "recommended": true,
      "style": {
        "useImportType": "error",
        "useBlockStatements": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "src/**"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "error"
          }
        }
      }
    }
  ]
}
