{
  "name": "@interest-protocol/blast-sdk",
  "version": "0.0.0",
  "description": "Deterministic off-chain previews, reads, and transaction builders for Blast V2",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/interest-protocol/blast-v2-sdk.git"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./admin": {
      "types": "./dist/admin/index.d.ts",
      "default": "./dist/admin/index.js"
    },
    "./blast-sui": {
      "types": "./dist/blast-sui/index.d.ts",
      "default": "./dist/blast-sui/index.js"
    },
    "./deployments": {
      "types": "./dist/deployments/index.d.ts",
      "default": "./dist/deployments/index.js"
    },
    "./holder-rewards": {
      "types": "./dist/holder-rewards/index.d.ts",
      "default": "./dist/holder-rewards/index.js"
    },
    "./launchpad": {
      "types": "./dist/launchpad/index.d.ts",
      "default": "./dist/launchpad/index.js"
    },
    "./launchpad/template": {
      "types": "./dist/launchpad/template.d.ts",
      "default": "./dist/launchpad/template.js"
    },
    "./migrators": {
      "types": "./dist/migrators/index.d.ts",
      "default": "./dist/migrators/index.js"
    },
    "./partners": {
      "types": "./dist/partners/index.d.ts",
      "default": "./dist/partners/index.js"
    },
    "./presale": {
      "types": "./dist/presale/index.d.ts",
      "default": "./dist/presale/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.18"
    }
  },
  "scripts": {
    "build": "node --eval \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "check:abi": "node scripts/check-contract-abi.mjs ../contracts",
    "check:abi:write": "node scripts/check-contract-abi.mjs ../contracts --write",
    "check": "npm run check:abi && npm run format:check && npm run lint && npm run typecheck && npm run check:package && npm test",
    "check:package": "npm run build && publint --strict && attw --pack . --profile esm-only",
    "format": "biome format --write . && biome check --write --only=assist/source/organizeImports .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc && tsc -p tsconfig.build.json --noEmit",
    "holder-rewards": "node scripts/holder-rewards.mjs",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@mysten/move-bytecode-template": "^0.4.1",
    "@mysten/sui": "^2.26.2"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.11",
    "@mysten/move-bytecode-template": "0.4.1",
    "@mysten/sui": "2.26.2",
    "@types/node": "^24.3.0",
    "publint": "^0.3.25",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
