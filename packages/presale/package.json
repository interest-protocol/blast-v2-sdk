{
  "name": "@interest-protocol/blast-presale-sdk",
  "version": "0.1.1",
  "description": "Blast presale SDK",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/interest-protocol/blast-v2-sdk.git",
    "directory": "packages/presale"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    "./aborts": {
      "types": "./dist/aborts.d.ts",
      "default": "./dist/aborts.js"
    },
    "./aftermath-dao": {
      "types": "./dist/aftermath-dao.d.ts",
      "default": "./dist/aftermath-dao.js"
    },
    "./aftermath-lp": {
      "types": "./dist/aftermath-lp.d.ts",
      "default": "./dist/aftermath-lp.js"
    },
    "./aftermath-native": {
      "types": "./dist/aftermath-native.d.ts",
      "default": "./dist/aftermath-native.js"
    },
    "./aftermath": {
      "types": "./dist/aftermath.d.ts",
      "default": "./dist/aftermath.js"
    },
    "./allowlist": {
      "types": "./dist/allowlist.d.ts",
      "default": "./dist/allowlist.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./creator-events": {
      "types": "./dist/creator-events.d.ts",
      "default": "./dist/creator-events.js"
    },
    "./creator": {
      "types": "./dist/creator.d.ts",
      "default": "./dist/creator.js"
    },
    "./events": {
      "types": "./dist/events.d.ts",
      "default": "./dist/events.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./math": {
      "types": "./dist/math.d.ts",
      "default": "./dist/math.js"
    },
    "./reducer": {
      "types": "./dist/reducer.d.ts",
      "default": "./dist/reducer.js"
    },
    "./state": {
      "types": "./dist/state.d.ts",
      "default": "./dist/state.js"
    },
    "./transactions": {
      "types": "./dist/transactions.d.ts",
      "default": "./dist/transactions.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node --eval \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:package": "publint --strict && attw --pack . --profile esm-only",
    "prepack": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@interest-protocol/blast-admin-sdk": "0.1.0",
    "@interest-protocol/blast-core": "0.1.0",
    "@interest-protocol/blast-launchpad-sdk": "0.1.1"
  },
  "peerDependencies": {
    "@mysten/move-bytecode-template": "^0.4.1",
    "@mysten/sui": "^2.26.2"
  }
}
