{
  "name": "@interest-protocol/blast-sdk",
  "version": "0.0.0",
  "description": "Deterministic off-chain previews, reads, and transaction builders for Blast V2",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./admin": "./src/admin/index.ts",
    "./blast-sui": "./src/blast-sui/index.ts",
    "./deployments": "./src/deployments/index.ts",
    "./holder-rewards": "./src/holder-rewards/index.ts",
    "./launchpad": "./src/launchpad/index.ts",
    "./launchpad/template": "./src/launchpad/template.ts",
    "./migrators": "./src/migrators/index.ts",
    "./partners": "./src/partners/index.ts",
    "./presale": "./src/presale/index.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "check:abi": "node scripts/check-contract-abi.mjs ../contracts",
    "check:abi:write": "node scripts/check-contract-abi.mjs ../contracts --write",
    "check": "npm run check:abi && npm run format:check && npm run lint && npm run typecheck && npm test",
    "format": "biome format --write . && biome check --write --only=assist/source/organizeImports .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc && tsc -p tsconfig.sdk.json",
    "holder-rewards": "node scripts/holder-rewards.mjs"
  },
  "peerDependencies": {
    "@mysten/move-bytecode-template": "^0.4.1",
    "@mysten/sui": "^2.26.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@mysten/move-bytecode-template": "0.4.1",
    "@mysten/sui": "2.26.2",
    "@types/node": "^24.3.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0"
  }
}
