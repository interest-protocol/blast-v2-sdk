{
  "name": "@interest-protocol/blast-holder-rewards-sdk",
  "version": "0.1.1",
  "description": "Blast holder-rewards SDK",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/interest-protocol/blast-v2-sdk.git",
    "directory": "packages/holder-rewards"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./operator": {
      "types": "./dist/operator.d.ts",
      "default": "./dist/operator.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node --eval \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:package": "publint --strict && attw --pack . --profile esm-only",
    "prepack": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@interest-protocol/blast-core": "0.1.0",
    "@interest-protocol/blast-migrators-sdk": "0.1.1",
    "@interest-protocol/blast-presale-sdk": "0.1.1"
  },
  "peerDependencies": {
    "@mysten/sui": "^2.26.2"
  }
}
